---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import Lightbox from '../components/Lightbox.astro';

const glacier = [
  { image_path: '/gallery/202509_baker/DSC00083.webp', width: 2560, height: 1440, loading: 'eager' as const, alt: '云层掠过 Mount Baker，冰川与深色岩脊交错铺满山坡' },
];
const details = [
  { image_path: '/gallery/202509_baker/DSC00084.webp', width: 1440, height: 2560, alt: '竖幅中的 Mount Baker 与冰川，明亮云层下是黑白相间的山坡' },
  { image_path: '/gallery/202509_baker/DSC00094.webp', width: 1440, height: 2560, alt: '近处冰面上的细密纹路延伸向山脊，远处群峰被阳光照亮' },
];
---

<BaseLayout title="Mount Baker - Q's Blog" description="2025.09 | Mount Baker，我在西雅图最喜欢的山。优雅的山形，云层下的冰川与岩脊。">
  <div class="container">
    <header class="gallery-header">
      <h1>Mount Baker</h1>
      <div class="gallery-description"><p><strong>2025.09 | Mount Baker</strong></p></div>
    </header>

    <section class="opening gallery-section" aria-label="冰川全景">
      <GalleryGrid images={glacier} layout="single" />
    </section>

    <div class="gallery-description story-note">
      <p><a href="https://www.usgs.gov/volcanoes/mount-baker">Mount Baker</a> 是我在西雅图最喜欢的山。它的峰顶圆缓，山脊向两侧舒展；雪与云相接，轮廓时隐时现，姿态却始终清朗。</p>
      <p>晴天，从西雅图和温哥华都能望见它。隔着国界的两座城，共有一座雪山的轮廓。风景换了，它仍在天际，安静而分明。</p>
    </div>

    <section class="details" aria-label="雪山与冰面，两张竖幅">
      <GalleryGrid images={details} layout="half" />
    </section>
    <div class="gallery-description scene-note">
      <p>近处的雪面并非纯白。灰蓝的冰纹之间，几道浅粉沿坡面延伸，浓处像薄薄的胭脂，淡处又回到雪里。</p>
      <p class="place-note">2025.09，Mount Baker</p>
    </div>
  </div>
  <Lightbox />
</BaseLayout>

<style>
  .opening :global(.gallery-grid) { max-width: 1100px; }
  .story-note, .scene-note { max-width: 720px; margin: 0 auto; color: var(--color-text); }
  .story-note { padding: 1rem 0 3rem; }
  .scene-note { padding: 0.5rem 0 4rem; }
  .place-note { font-size: 0.85rem; margin-top: 1.25rem; color: var(--color-text-muted); }
  .details { max-width: 900px; margin: 0 auto; }
  .details :global(.gallery-grid.layout-half) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.5rem, 1.5vw, 1.25rem);
  }
  section :global(.gallery-item img) { height: auto; object-fit: contain; }
  @media (max-width: 768px) {
    .story-note { padding-bottom: 2rem; }
  }
</style>
