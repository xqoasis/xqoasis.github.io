---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import Lightbox from '../components/Lightbox.astro';

const water = [
  { image_path: '/gallery/202505_downton/DSC00057.webp', alt: 'Downton 林间水面，青蓝色倒影与交错的树枝' },
];
---

<BaseLayout title="Downton - Q's Blog" description="2025.05 | Downton，林间水景。">
  <div class="container">
    <div class="gallery-header">
      <h1>Downton</h1>
      <div class="gallery-description">
        <p><strong>2025.05 | Downton</strong></p>
        <p>林间水景。</p>
      </div>
    </div>

    <section class="gallery-section">
      <GalleryGrid images={water} layout="single" caption="2025.05，Downton" />
    </section>
  </div>

  <Lightbox />
</BaseLayout>

<style>
  .gallery-section :global(.gallery-grid.layout-single) {
    max-width: none;
  }
</style>
