---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import Lightbox from '../components/Lightbox.astro';

const residence = [
  { image_path: '/gallery/202505_downton/DSC00005.webp', alt: 'Bloedel Reserve 的白色住宅，前方是草坪与蓝绿色池塘，两侧高树环抱' },
];

const details = [
  { image_path: '/gallery/202505_downton/DSC00037.webp', alt: '住宅的对称门窗与铁艺阳台，门洞框住一位访客、远处的海湾与雪山' },
  { image_path: '/gallery/202505_downton/DSC00009.webp', alt: '垂柳伸向池塘，明亮的浮萍沿岸弯出一道曲线' },
  { image_path: '/gallery/202505_downton/DSC00044.webp', alt: '日式客舍前的砂石庭园，苔石周围耙出同心纹路' },
];

const garden = [
  { image_path: '/gallery/202505_downton/DSC00049.webp', alt: '阳光穿过低垂的树枝，照亮庭园中的苔地与石头' },
];

const reflectionPool = [
  { image_path: '/gallery/202505_downton/DSC00053.webp', alt: 'Reflection Pool 两侧的绿篱与草坪向远处收拢，水面映出森林' },
];

const forest = [
  { image_path: '/gallery/202505_downton/DSC00042.webp', alt: '横倒的树干与水中倒影组成交错的三角形，四周是茂密森林' },
  { image_path: '/gallery/202505_downton/DSC00057.webp', alt: '林间水面上的青蓝色倒影与交错树枝' },
];
---

<BaseLayout title="Bloedel Reserve - Q's Blog" description="2025.05 | Bainbridge Island 的 Bloedel Reserve：白色庄园、日式庭园与森林倒影。">
  <div class="container">
    <div class="gallery-header">
      <h1>Bloedel Reserve</h1>
      <div class="gallery-description">
        <p><strong>2025.05 | Bainbridge Island</strong></p>
        <ul>
          <li><a href="https://bloedelreserve.org/gardens-2/">Bloedel Reserve</a>，Bainbridge 岛上的森林花园。草坪、池塘、日式庭园和树林，在这里连成一段步行路线。</li>
          <li>白色宅邸有让人想到《唐顿庄园》的气质。它实际采用法国乡间别墅风格，1932 年落成，后来成为 Bloedel 夫妇的家。<a href="https://bloedelreserve.org/lasting-legacy/">住宅历史</a></li>
        </ul>
      </div>
    </div>

    <section class="gallery-section">
      <GalleryGrid images={residence} layout="single" caption="The Residence，池塘另一侧的白色宅邸" />
      <GalleryGrid images={details} layout="third" caption="门洞里的海景、池边的垂柳、砂石间的纹路" />
      <GalleryGrid images={garden} layout="single" />
      <GalleryGrid images={reflectionPool} layout="single" caption="Reflection Pool，绿篱与森林的对称倒影" />
      <GalleryGrid images={forest} layout="single" caption="2025.05，Bloedel Reserve" />
    </section>
  </div>

  <Lightbox />
</BaseLayout>

<style>
  .gallery-section :global(.gallery-grid.layout-single) {
    max-width: none;
  }
</style>
