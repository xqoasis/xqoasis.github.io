---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import Lightbox from '../components/Lightbox.astro';

const glacier = [
  { image_path: '/gallery/202509_rainier/DSC00083.webp', width: 2560, height: 1440, loading: 'eager' as const, alt: '云层掠过 Rainier 山体，冰川与深色岩脊交错铺满山坡' },
];
const details = [
  { image_path: '/gallery/202509_rainier/DSC00084.webp', width: 1440, height: 2560, alt: '竖幅中的雪山与冰川，明亮云层下是黑白相间的山坡' },
  { image_path: '/gallery/202509_rainier/DSC00094.webp', width: 1440, height: 2560, alt: '近处冰面上的细密纹路延伸向山脊，远处群峰被阳光照亮' },
];
---

<BaseLayout title="Mount Rainier - Q's Blog" description="2025.09 | 云层下的 Mount Rainier，冰川、岩脊与冰面纹理。">
  <div class="container">
    <header class="gallery-header">
      <h1>Mount Rainier</h1>
      <div class="gallery-description"><p><strong>2025.09 | Mount Rainier National Park</strong></p></div>
    </header>

    <section class="opening gallery-section" aria-label="冰川全景">
      <GalleryGrid images={glacier} layout="single" />
    </section>

    <div class="gallery-description story-note">
      <ul>
        <li>Mount Rainier 的山体分布着多条<a href="https://www.nps.gov/mora/learn/nature/mount-rainier-glaciers.htm">冰川</a>，冰流沿山坡向下延伸。</li>
        <li>云一散开，雪、冰和岩石之间的纹理就清楚了。远看是整座山，近看是冰面上细密的线。</li>
      </ul>
    </div>

    <section class="details" aria-label="雪山与冰面，两张竖幅">
      <GalleryGrid images={details} layout="half" caption="2025.09，Mount Rainier" />
    </section>
  </div>
  <Lightbox />
</BaseLayout>

<style>
  .opening :global(.gallery-grid) { max-width: 1100px; }
  .story-note { max-width: 800px; margin: 0 auto; padding: 1rem 0 3rem; }
  .details { max-width: 900px; margin: 0 auto; padding-bottom: 4rem; }
  .details :global(.gallery-grid.layout-half) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.5rem, 1.5vw, 1.25rem);
  }
  section :global(.gallery-item img) { height: auto; object-fit: contain; }
  @media (max-width: 768px) {
    .story-note { padding-bottom: 2rem; }
  }
</style>
