---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import Lightbox from '../components/Lightbox.astro';

const summit = [
  { image_path: '/gallery/202507_dickerman/DSC00280.webp', alt: 'Clouds drifting across the rocky ridgeline of Mount Dickerman' },
];

const flowersAndHiker = [
  { image_path: '/gallery/202507_dickerman/DSC00196.webp', alt: 'White and yellow wildflowers beneath misty conifers on Mount Dickerman' },
  { image_path: '/gallery/202507_dickerman/DSC00264.webp', alt: 'A hiker in a purple jacket standing before the cloud-covered ridgeline' },
];

const forest = [
  { image_path: '/gallery/202507_dickerman/DSC00182.webp', alt: 'Layers of evergreen forest fading into fog on Mount Dickerman' },
];
---

<BaseLayout title="Mount Dickerman - Q's Blog" description="2025.07 | Mount Dickerman：雾林、野花，和云里忽隐忽现的山脊。">
  <div class="container">
    <div class="gallery-header">
      <h1>Mount Dickerman</h1>
      <div class="gallery-description">
        <p><strong>2025.07 | Mount Dickerman</strong></p>
        <ul>
          <li><a href="https://www.wta.org/go-hiking/hikes/mount-dickerman">Trail Info</a>
            <ul>
              <li>Length: 8.2mi (round trip)</li>
              <li>Elevation gain: 3,950ft</li>
            </ul>
          </li>
          <li>Mountain Loop Highway 上的一条登顶路线。前半段在森林里连续爬升，之后走进草甸，登上山脊。天气不太好，前半段一直在雾里。我起得太早了，也没睡醒，感觉跟做梦一样。</li>
          <li>雾林、野花，和云里忽隐忽现的山。又好像在打黑神话，开局在瘴气弥漫的溪流旁边。</li>
        </ul>
      </div>
    </div>

    <section class="gallery-section">
      <GalleryGrid images={summit} layout="single" caption="Mount Dickerman, in the clouds" />
      <GalleryGrid images={flowersAndHiker} layout="half" />
      <GalleryGrid images={forest} layout="single" caption="2025.07, Mount Dickerman" />
    </section>
  </div>

  <Lightbox />
</BaseLayout>
