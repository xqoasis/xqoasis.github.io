---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import Lightbox from '../components/Lightbox.astro';

const closing = [
  { image_path: '/gallery/202505_downton/DSC00042.webp', alt: '横倒的树干与水中倒影组成交错的三角形，四周是茂密森林' },
];

const estate = [
  { file: 'DSC00005', position: 'estate-landscape', width: 2560, height: 1440, alt: 'Bloedel Reserve 的白色住宅，前方是草坪与蓝绿色池塘，两侧高树环抱' },
  { file: 'DSC00036', position: 'estate-portrait', width: 1440, height: 2560, alt: '住宅的对称门窗与铁艺阳台，门洞框住一位访客、海湾与远处的雪山' },
  { file: 'DSC00049', position: 'estate-landscape', width: 2560, height: 1440, alt: '阳光穿过低垂的树枝，照亮庭园中的苔地与石头' },
];

const textures = [
  { image_path: '/gallery/202505_downton/DSC00011.webp', alt: '幽暗垂柳前，阳光照亮池塘上的浮萍与树影' },
  { image_path: '/gallery/202505_downton/DSC00044.webp', alt: '日式客舍前的砂石庭园，苔石周围耙出同心纹路' },
];

const featured = [
  { image_path: '/gallery/202505_downton/DSC00057.webp', alt: '林间水面上的青蓝色倒影与交错树枝' },
];
---

<BaseLayout title="Bloedel Reserve - Q's Blog" description="2025.05 | Bainbridge Island 的 Bloedel Reserve：白色庄园、日式庭园与森林倒影。">
  <div class="container">
    <div class="gallery-header">
      <h1>Bloedel Reserve</h1>
      <div class="gallery-description">
        <p><strong>2025.05 | Bainbridge Island</strong></p>
      </div>
    </div>
  </div>

  <section class="featured-section" aria-label="林间水景">
    <GalleryGrid images={featured} layout="single" />
  </section>

  <div class="container">
    <div class="gallery-description story-note">
        <ul>
          <li><a href="https://bloedelreserve.org/gardens-2/">Bloedel Reserve</a>，Bainbridge 岛上的森林花园。草坪、池塘、日式庭园和树林，在这里连成一段步行路线。</li>
          <li>白色宅邸有让人想到《唐顿庄园》的气质。它实际采用法国乡间别墅风格，1932 年落成，后来成为 Bloedel 夫妇的家。<a href="https://bloedelreserve.org/lasting-legacy/">住宅历史</a></li>
        </ul>
    </div>

    <section class="estate-section" aria-label="住宅与庭园">
      <div class="estate-spread">
        {estate.map(photo => (
          <div class={`gallery-item ${photo.position}`} data-full={`/gallery/202505_downton/${photo.file}.webp`}>
            <img src={`/gallery/202505_downton/${photo.file}.webp`} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" />
          </div>
        ))}
      </div>
      <p class="gallery-caption">The Residence，宅邸、门洞里的海景与树下的光</p>
    </section>

    <section class="texture-section" aria-label="浮萍与砂纹">
      <GalleryGrid images={textures} layout="half" caption="浮萍与砂纹，两种水波般的曲线" />
    </section>

    <section class="closing-section" aria-label="森林镜像">
      <GalleryGrid images={closing} layout="single" caption="2025.05，Bloedel Reserve" />
    </section>
  </div>

  <Lightbox />
</BaseLayout>

<style>
  .closing-section {
    padding-bottom: 3rem;
  }

  .closing-section :global(.gallery-item img) {
    height: auto;
    object-fit: contain;
  }

  .story-note {
    max-width: 800px;
    padding: 2.5rem 0;
    margin-bottom: 0;
  }

  .estate-spread {
    display: grid;
    grid-template-columns: minmax(0, 1.56fr) minmax(0, 1fr);
    gap: 1rem;
  }

  .estate-landscape {
    grid-column: 1;
  }

  .estate-landscape img {
    aspect-ratio: 16 / 9;
  }

  .estate-portrait {
    grid-column: 2;
    grid-row: 1 / span 2;
    min-height: 0;
  }

  .estate-section {
    padding-bottom: 4rem;
  }

  .texture-section {
    max-width: 900px;
    margin: 0 auto;
    padding-bottom: 3rem;
  }

  .texture-section :global(.gallery-grid.layout-half) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.5rem, 1vw, 0.75rem);
  }

  .featured-section {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 6rem) clamp(1rem, 4vw, 5rem) 3rem;
  }

  .featured-section :global(.gallery-grid.layout-single) {
    max-width: none;
  }

  @media (max-width: 768px) {
    .estate-spread {
      grid-template-columns: 1fr;
    }

    .estate-landscape,
    .estate-portrait {
      grid-column: auto;
      grid-row: auto;
    }

    .estate-portrait img {
      height: auto;
    }

    .story-note {
      padding: 1.5rem 0;
    }

    .estate-section {
      padding-bottom: 2.5rem;
    }
  }
</style>
